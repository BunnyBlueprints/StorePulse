generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  address   String
  role      String   // SYSTEM_ADMIN, NORMAL_USER, STORE_OWNER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings   Rating[]
  store     Store?   @relation("StoreOwner", fields: [storeId], references: [id])
  storeId   String?  @unique
}

model Store {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  address       String
  averageRating Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ratings       Rating[]
  owner         User?    @relation("StoreOwner")
}

model Rating {
  id        String   @id @default(uuid())
  score     Int
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])
}
